* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;

    background: #1a1a24;
    color: #ffffff;

    font-family:
        "Hiragino Kaku Gothic ProN",
        "Yu Gothic",
        sans-serif;

    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
}

#game-container {
    position: fixed;
    inset: 0;
    overflow: hidden;
}

#canvas-container {
    width: 100%;
    height: 100%;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
}