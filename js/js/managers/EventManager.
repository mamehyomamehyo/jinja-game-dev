 */

(() => {
    "use strict";

    class GameEventManager {

        /**
         * @param {GameData} gameData
         * @param {EventData} eventData
         */
        constructor(gameData, eventData) {

            this.gameData = gameData;
            this.eventData = eventData;

            this.completed = new Set();
            this.queue = [];
        }

        /**
         * イベント判定
         */
        update() {

            const events = this.eventData.getSorted();

            for (const event of events) {

                if (event.once && this.completed.has(event.id)) {
                    continue;
                }

                if (!this.checkCondition(event.condition)) {
                    continue;
                }

                this.trigger(event);
            }
        }

        /**
         * 条件判定
         */
        checkCondition(condition) {

            const stats = this.gameData.statistics;
            const status = this.gameData.status;

            if (
                condition.prayerCount !== undefined &&
                stats.prayerCount < condition.prayerCount
            ) {
                return false;
            }

            if (
                condition.visitCount !== undefined &&
                stats.visitCount < condition.visitCount
            ) {
                return false;
            }

            if (
                condition.fortuneCount !== undefined &&
                stats.fortuneCount < condition.fortuneCount
            ) {
                return false;
            }

            if (
                condition.purchaseCount !== undefined &&
                stats.purchaseCount < condition.purchaseCount
            ) {
                return false;
            }

            if (
                condition.faith !== undefined &&
                status.faith < condition.faith
            ) {
                return false;
            }

            if (
                condition.money !== undefined &&
                status.money < condition.money
            ) {
                return false;
            }

            return true;
        }

        /**
         * イベント発生
         */
        trigger(event) {

            this.applyReward(event.reward);

            this.completed.add(event.id);

            this.queue.push(event);
        }

        /**
         * 報酬適用
         */
        applyReward(reward) {

            if (!reward) {
                return;
            }

            if (reward.faith) {
                this.gameData.addFaith(reward.faith);
            }

            if (reward.money) {
                this.gameData.addMoney(reward.money);
            }
        }

        /**
         * 次のイベント取得
         */
        pop() {

            if (this.queue.length === 0) {
                return null;
            }

            return this.queue.shift();
        }

        /**
         * 待機イベント有無
         */
        hasEvent() {

            return this.queue.length > 0;
        }

        /**
         * 発生済み判定
         */
        isCompleted(id) {

            return this.completed.has(id);
        }

        /**
         * リセット
         */
        reset() {

            this.completed.clear();
            this.queue.length = 0;
        }

    }

    window.GameEventManager = GameEventManager;

})();